# nginx — LG Remote gateway behind HTTPS (example; replace remote.example.com)
# certbot --nginx -d remote.example.com   adds the TLS lines.
server {
    listen 80;
    server_name remote.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name remote.example.com;
    # ssl_certificate     /etc/letsencrypt/live/remote.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/remote.example.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:3060;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The gateway reads the client IP from X-Real-IP when KUMANDA_PROXY=1 (brute-force lock is per IP).
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Turning on a TV can take ~40 s; the live preview is a long-lived multipart stream.
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
